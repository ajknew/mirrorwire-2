<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESET TATA LETAK (LAYOUT)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pilih preset instan atau sesuaikan elemen tampilan &amp; kamera overlay"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- Preset Buttons Grid -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Preset Siap Pakai:"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_preset_pip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#0F172A"
                android:text="PIP CAMERA"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_preset_split"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#0F172A"
                android:text="SPLIT VIEW"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_preset_display_only"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#0F172A"
                android:text="DISPLAY ONLY"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Element Controls Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pengaturan Elemen Display Capture:"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_display_visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Tampilkan Layar Mirror"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cb_display_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Kunci Posisi Layar Mirror"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pengaturan Elemen Kamera Overlay (HOST):"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_camera_visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Aktifkan Overlay Kamera"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cb_camera_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Kunci Posisi &amp; Ukuran Kamera (Cegah Geser)"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_toggle_layer_z"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#334155"
            android:text="UBAH URUTAN LAYER (Z-ORDER)"
            android:textColor="#38BDF8"
            android:textSize="11sp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_close_layout"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#2563EB"
                android:text="SELESAI"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
