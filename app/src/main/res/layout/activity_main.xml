<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:fitsSystemWindows="true">

    <!-- Top App Header -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="#1E293B">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIRRORWIRE V2"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USB OTG Screen Mirroring • H.264 Hardware Decoder"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="USB DISCONNECTED"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Live Indicators Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_fps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="FPS: 0"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="RES: --"
                    android:textColor="#A78BFA"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chip_bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="BITRATE: 3.0 Mbps"
                    android:textColor="#34D399"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chip_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="AUDIO: OFF"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Main Workspace (Video + Camera Overlay) -->
    <FrameLayout
        android:id="@+id/workspace_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:background="#000000">

        <!-- Display Capture Surface -->
        <SurfaceView
            android:id="@+id/display_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Idle Placeholder / Instructions -->
        <LinearLayout
            android:id="@+id/idle_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB OTG DISPLAY AREA"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_idle_instruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="280dp"
                android:text="Hubungkan kabel USB OTG dari HOST ke perangkat CLIENT. Aktifkan USB Debugging pada CLIENT, lalu tekan START MIRROR."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Live badge indicator -->
        <TextView
            android:id="@+id/tv_live_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="#99000000"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="● LIVE"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Draggable & Resizable HOST Camera PIP Overlay Container -->
        <FrameLayout
            android:id="@+id/camera_overlay_container"
            android:layout_width="140dp"
            android:layout_height="180dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_camera_overlay"
            android:padding="2dp"
            android:visibility="gone">

            <TextureView
                android:id="@+id/camera_texture_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Camera Overlay Controls Bar -->
            <LinearLayout
                android:id="@+id/camera_controls_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#B3000000"
                android:gravity="end"
                android:orientation="horizontal"
                android:padding="2dp">

                <Button
                    android:id="@+id/btn_cam_switch"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="↻"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_cam_lock"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="🔓"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_cam_close"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="✕"
                    android:textColor="#EF4444"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Controls & Actions Section -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="#1E293B">

        <!-- Primary Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start_mirror"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:backgroundTint="#2563EB"
                android:text="START MIRROR"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_stop_mirror"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:layout_marginStart="6dp"
                android:backgroundTint="#DC2626"
                android:text="STOP MIRROR"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:enabled="false" />

            <Button
                android:id="@+id/btn_live_mirror"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#475569"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Secondary Config Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_capture_settings"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="SETTINGS"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_layout_preset"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#334155"
                android:text="LAYOUT"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_audio_toggle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#334155"
                android:text="AUDIO"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_camera_toggle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#334155"
                android:text="CAMERA"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Diagnostics & System Log Section -->
    <LinearLayout
        android:id="@+id/log_section_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#0F172A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DIAGNOSTIK &amp; LOG SISTEM"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_copy_log"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#1E293B"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="COPY LOG"
                android:textColor="#38BDF8"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_clear_log"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1E293B"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="CLEAR"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Monospace Scrollable Log Console -->
        <ScrollView
            android:id="@+id/scroll_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_log_console"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_system_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="[00:00:00.000] [SYSTEM] MirrorWire V2 Initialized. Ready for USB connection.\n"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
