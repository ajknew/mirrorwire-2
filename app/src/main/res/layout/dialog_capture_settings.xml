<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENGATURAN CAPTURE &amp; STREAM"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Konfigurasi parameter screenrecord pada perangkat CLIENT dan render HOST"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- Source Resolution -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Resolusi Sumber (CLIENT):"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_resolution"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="#0F172A" />

        <!-- Source Bitrate -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bitrate Encoder Sumber (CLIENT):"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_bitrate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="#0F172A" />

        <TextView
            android:id="@+id/tv_bitrate_conversion_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Integer Bitrate: 3,000,000 bps"
            android:textColor="#34D399"
            android:textSize="11sp" />

        <!-- HOST Frame Dispatch Target -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="FPS Pengiriman Buffer ke Layar HOST:"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_host_fps"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="*Catatan Teknis: Pilihan FPS HOST mengatur kecepatan submit frame ke Surface HOST; ini tidak mengubah kemampuan clock hardware encoder CLIENT."
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp" />

        <!-- Continuous Mirroring Loop Checkbox -->
        <CheckBox
            android:id="@+id/cb_continuous_loop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="Loop Mirror Otomatis (Mencegah batas waktu screenrecord 180s)"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <!-- Dialog Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#334155"
                android:text="BATAL"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_save_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2563EB"
                android:text="SIMPAN"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
